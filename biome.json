{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!docs",
      "!**/*.md",
      "!**/*.css",
      "!**/*.tsbuildinfo"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true }
}
